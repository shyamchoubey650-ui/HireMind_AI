# # Copy to .env and load with `export $(cat .env | xargs)` or python-dotenv if you add it.
# # Default: SQLite, zero setup, file created automatically as hiremind.db
# DATABASE_URL=sqlite:///./hiremind.db
# # To use PostgreSQL instead (e.g. via docker-compose):
# # DATABASE_URL=postgresql+psycopg2://hiremind:hiremind@localhost:5432/hiremind
# JWT_SECRET=change-me-in-production

# # Required only for AI question generation (set_generator.py's LLM tier,
# # used when the persistent question bank + hardcoded pool can't cover a
# # requested number of unique assessment sets on their own). Everything
# # else in the app works fine with this unset.
# OPENAI_API_KEY=sk-your-key-here
# # Optional -- defaults to gpt-4o-mini if unset.
# OPENAI_MODEL=gpt-4o-mini
# # Optional -- defaults to OPENAI_MODEL if unset. Coding-question
# # generation is more failure-prone (more fields, stricter format
# # requirements), so you may want a stronger model just for that.
# OPENAI_CODING_MODEL=gpt-4o-mini



DATABASE_URL=sqlite:///./hiremind.db
JWT_SECRET=change-me-in-production

FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback